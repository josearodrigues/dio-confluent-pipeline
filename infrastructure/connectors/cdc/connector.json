{
  "name": "payments-postgres-cdc",
  "connector.class": "PostgresCdcSourceV2",
  "kafka.auth.mode": "SERVICE_ACCOUNT",
  "kafka.service.account.id": "${SA_WRITER_ID}",
  "database.hostname": "${PG_HOST}",
  "database.port": "${PG_PORT}",
  "database.user": "${PG_CDC_USER}",
  "database.password": "${PG_CDC_PASSWORD}",
  "database.dbname": "${PG_DATABASE}",
  "topic.prefix": "payments",
  "table.include.list": "payments.customers,payments.accounts,payments.cards,payments.transactions",
  "plugin.name": "pgoutput",
  "slot.name": "payments_slot",
  "publication.name": "payments_pub",
  "publication.autocreate.mode": "disabled",
  "snapshot.mode": "initial",
  "output.data.format": "AVRO",
  "output.key.format": "AVRO",
  "after.state.only": "false",
  "transforms": "renameTopic",
  "transforms.renameTopic.type": "io.confluent.connect.cloud.transforms.TopicRegexRouter",
  "transforms.renameTopic.regex": "^payments\\.payments\\.(.*)$",
  "transforms.renameTopic.replacement": "payments.$1",
  "tasks.max": "1",
  "database.sslmode": "require"
}
